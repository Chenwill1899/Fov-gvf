Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Ground grid
      Enabled: true
      Plane: XY
      Plane Cell Count: 20
      Cell Size: 1
      Color: 100; 100; 100
    - Class: rviz_default_plugins/MarkerArray
      Name: Robot and command
      Enabled: true
      Topic:
        Value: /pc_gvf/markers
        Reliability Policy: Reliable
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/MarkerArray
      Name: Test scenario
      Enabled: true
      Topic:
        Value: /pc_gvf/scenario
        Reliability Policy: Reliable
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/MarkerArray
      Name: FOV and angular GVF
      Enabled: true
      Topic:
        Value: /pc_gvf/angular_field
        Reliability Policy: Reliable
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/Path
      Name: Executed path
      Enabled: true
      Topic:
        Value: /pc_gvf/path
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Line Style: Lines
      Line Width: 0.04
      Color: 25; 255; 80
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Enabled: true
      Topic:
        Value: /sim/odom
        Reliability Policy: Reliable
      Shape:
        Value: Axes
    - Class: rviz_default_plugins/Image
      Name: Forward depth
      Enabled: true
      Topic:
        Value: /sim/depth/image_raw
        Reliability Policy: Best Effort
      Normalize Range: true
      Median window: 5
  Enabled: true
  Global Options:
    Background Color: 30; 30; 35
    Fixed Frame: world
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 12
      Focal Point: {X: 2, Y: 0, Z: 0}
      Name: Current View
      Pitch: 0.55
      Target Frame: world
      Yaw: 0.8
Window Geometry:
  Height: 900
  Width: 1400
