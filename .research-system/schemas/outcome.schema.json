{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research-flywheel-outcome-v1",
  "title": "Research Flywheel Worker Outcome",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "agent_id", "node_id", "attempt_id", "status", "verdict", "summary", "artifacts", "checks", "facts", "proposed_graph_changes", "blockers", "next_actions", "created_at"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "agent_id": {"type": "string", "minLength": 1},
    "node_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["partial", "completed", "failed", "blocked"]},
    "verdict": {"enum": ["not_assessed", "supported", "refuted", "insufficient_evidence", "invalid_run"]},
    "summary": {"type": "string"},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind", "sha256"],
        "properties": {
          "path": {"type": "string"},
          "kind": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "evidence"],
        "properties": {
          "name": {"type": "string"},
          "status": {"enum": ["passed", "failed", "skipped"]},
          "evidence": {"type": "string"}
        }
      }
    },
    "facts": {"type": "array", "items": {"type": "object"}},
    "proposed_graph_changes": {"type": "array", "items": {"type": "object"}},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "next_actions": {"type": "array", "items": {"type": "string"}},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "reasoning_effort"],
      "properties": {
        "name": {"type": ["string", "null"]},
        "reasoning_effort": {"type": ["string", "null"]}
      }
    },
    "created_at": {"type": "string"}
  }
}
