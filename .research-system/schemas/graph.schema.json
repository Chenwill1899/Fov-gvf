{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research-flywheel-graph-v1",
  "title": "Research Flywheel Graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "revision", "created_at", "updated_at", "nodes", "edges"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "project_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 0},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"},
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "title", "status", "verdict", "freshness", "priority", "version", "owner_agent", "model_tier", "required_skills", "input_artifacts", "output_artifacts", "acceptance", "claim_ceiling", "metadata", "created_at", "updated_at"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {"enum": ["problem", "source", "gap", "hypothesis", "claim", "experiment_spec", "implementation", "run", "finding", "figure_table", "manuscript_section", "review_issue", "decision"]},
          "title": {"type": "string", "minLength": 1},
          "status": {"enum": ["proposed", "ready", "running", "partial", "completed", "failed", "blocked", "retired"]},
          "verdict": {"enum": ["not_assessed", "supported", "refuted", "insufficient_evidence", "invalid_run"]},
          "freshness": {"enum": ["current", "stale"]},
          "priority": {"type": "integer"},
          "version": {"type": "integer", "minimum": 1},
          "owner_agent": {"type": "string", "minLength": 1},
          "model_tier": {"type": "string", "minLength": 1},
          "required_skills": {"type": "array", "items": {"type": "string"}},
          "input_artifacts": {"type": "array", "items": {"type": "string"}},
          "output_artifacts": {"type": "array", "items": {"type": "string"}},
          "acceptance": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "claim_ceiling": {"type": ["string", "null"], "enum": [null, "idea_only", "pilot_supported", "simulation_supported", "real_world_supported", "independently_reproduced"]},
          "metadata": {"type": "object"},
          "created_at": {"type": "string"},
          "updated_at": {"type": "string"}
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "type"],
        "properties": {
          "from": {"type": "string"},
          "to": {"type": "string"},
          "type": {"enum": ["depends_on", "motivates", "predicts", "tested_by", "implemented_by", "executed_as", "produces", "supports", "refutes", "visualized_by", "stated_in", "targets", "supersedes"]},
          "requirement": {"enum": ["completed", "supported"]}
        }
      }
    }
  }
}
