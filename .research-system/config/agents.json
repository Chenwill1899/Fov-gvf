        "review_issue"
      ],
      "required_skills": [
        "research-graph-protocol",
        "experiment-contract"
      ],
      "default_model_tier": "deep",
      "read_paths": [
        ".research/graph.json",
        "claims/",
        "findings/",
        "reviews/",
        "experiments/specs/",
        ".research/project.json",
        ".research-system/",
        "data/"
      ],
      "write_paths": [
        "experiments/specs/",
        ".research/inbox/"
      ],
      "forbidden": [
        "inspect outcomes before protocol freeze",
        "implement code",
        "silently revise frozen specification"
      ],
      "allowed_model_tiers": [
        "light",
        "balanced_code",
        "deep",
        "critical"
      ]
    },
    {
