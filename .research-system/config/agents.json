{
  "schema_version": "1.0",
  "agents": [
    {
      "id": "research-governor",
      "prompt": ".research-system/agents/research-governor.md",
      "accepts_node_types": [
        "problem",
        "source",
        "gap",
        "hypothesis",
        "claim",
        "experiment_spec",
        "implementation",
        "run",
        "finding",
        "figure_table",
        "manuscript_section",
        "review_issue",
        "decision"
      ],
      "required_skills": [
        "research-graph-protocol"
      ],
      "default_model_tier": "balanced_code",
      "read_paths": [
        ".research/",
        "claims/",
        "experiments/",
        "runs/",
        "findings/",
        "figures/",
        "paper/",
        "reviews/",
        ".research/project.json",
        ".research-system/"
      ],
      "write_paths": [
        ".research/"
      ],
      "forbidden": [
        "create scientific findings",
        "approve own evidence",
        "invent human approval",
        "modify raw run artifacts"
      ],
      "allowed_model_tiers": [
        "light",
        "balanced_code",
        "deep"
      ]
    },
    {
      "id": "literature-novelty-scout",
      "prompt": ".research-system/agents/literature-novelty-scout.md",
      "accepts_node_types": [
        "problem",
        "source",
        "gap"
      ],
      "required_skills": [
        "research-graph-protocol",
        "literature-grounding"
      ],
      "default_model_tier": "light",
      "read_paths": [
        ".research/graph.json",
        ".research/brief.md",
        "claims/",
        ".research/project.json",
        ".research-system/"
      ],
      "write_paths": [
        "claims/sources/",
        "claims/gaps/",
        ".research/inbox/"
      ],
      "forbidden": [
        "edit paper",
        "declare novelty from snippets",
        "invent citations",
        "propose measured findings"
      ],
      "allowed_model_tiers": [
        "light",
        "balanced_code",
        "deep"
      ]
    },
    {
      "id": "claim-architect",
      "prompt": ".research-system/agents/claim-architect.md",
