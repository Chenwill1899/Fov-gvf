      "forbidden": [
        "modify implementation code",
        "modify raw run files",
        "modify frozen protocols",
        "edit manuscript prose"
      ],
      "allowed_model_tiers": [
        "light",
        "balanced_code",
        "deep",
        "critical"
      ]
    },
    {
      "id": "paper-composer",
      "prompt": ".research-system/agents/paper-composer.md",
      "accepts_node_types": [
        "claim",
        "finding",
