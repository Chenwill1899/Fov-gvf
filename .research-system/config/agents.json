      "default_model_tier": "balanced_code",
      "read_paths": [
        ".research/graph.json",
        "claims/",
        "experiments/specs/",
        "src/",
        "tests/",
        ".research/project.json",
        ".research-system/",
        "data/"
      ],
      "write_paths": [
        "src/",
        "tests/",
