      "forbidden": [
        "edit graph",
        "edit frozen experiment specification",
        "edit paper",
        "interpret scientific support"
      ],
      "allowed_model_tiers": [
        "fast_code",
        "light",
        "balanced_code",
        "deep"
      ]
    },
    {
      "id": "experiment-runner",
