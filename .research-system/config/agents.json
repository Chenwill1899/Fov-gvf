      "read_paths": [
        ".research/graph.json",
        "claims/",
        "experiments/specs/",
        "src/",
        "runs/",
        "findings/",
        "figures/",
        ".research/project.json",
        ".research-system/",
        "data/"
      ],
      "write_paths": [
        "findings/",
        "reviews/audits/",
        ".research/inbox/"
