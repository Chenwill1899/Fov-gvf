        "claims/",
        "findings/",
        "reviews/",
        ".research/project.json",
        ".research-system/"
      ],
      "write_paths": [
        "claims/",
        ".research/inbox/"
      ],
      "forbidden": [
        "write implementation code",
        "modify raw findings",
        "call predictions observations",
        "raise claim ceiling"
      ],
      "allowed_model_tiers": [
        "light",
        "balanced_code",
        "deep",
        "critical"
      ]
    },
    {
      "id": "experiment-architect",
      "prompt": ".research-system/agents/experiment-architect.md",
      "accepts_node_types": [
        "claim",
