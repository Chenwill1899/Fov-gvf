        "manuscript_section"
      ],
      "required_skills": [
        "research-graph-protocol",
        "claim-first-scientific-writing"
      ],
      "default_model_tier": "balanced_code",
      "read_paths": [
        ".research/graph.json",
        "claims/",
        "findings/",
        "figures/",
        "paper/",
        ".research/project.json",
        ".research-system/"
      ],
      "write_paths": [
        "paper/",
        "figures/",
        ".research/inbox/"
