# Source this file, then run scripts/run_isaac_fov_gvf_navigation.sh.
# Saved joystick parameters on the unified original Cloud map.
EGO_PROFILE_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
export ISAAC_MANUAL_INPUT_MODE=joystick ISAAC_HEADLESS=0 ISAAC_MANUAL_TIMEOUT=0
export FOV_GVF_RVIZ=true
export JOYSTICK_HORIZONTAL_SPEED=10 JOYSTICK_VERTICAL_SPEED=1
export ISAAC_PLANT_ACCEL=16 ISAAC_PLANT_TAU=.10 ISAAC_COMMAND_FRAME=world
export FOV_GVF_SCENE_MODE=cloud
export FOV_GVF_SCENE="$EGO_PROFILE_ROOT/scenes/ego_swarm_cloud/ego_swarm_cloud_navigation.usd"
export FOV_GVF_INSTALL=/home/starry/isaac-data/EGO2P6/docs/performance/runtime/install
export FOV_GVF_CONTROLLER_EXECUTABLE="$FOV_GVF_INSTALL/pc_gvf/lib/pc_gvf/depth_angular_controller"
export FOV_GVF_MAX_DEPTH=20 FOV_GVF_PLANNING_HORIZON=.5
export FOV_GVF_GOAL_CACHE=1 FOV_GVF_GOAL_CACHE_TTL=.3
export FOV_GVF_EMERGENCY_CERTIFICATE=1 FOV_GVF_GOAL_SPEED_GOVERNOR=0
export FOV_GVF_FREE_SPACE_FLOOR_ENABLED=1 FOV_GVF_FREE_SPACE_FLOOR_Z=0
export FOV_GVF_SMOOTH_SPEED=0 FOV_GVF_DIRECTION_RATE=8
export FOV_GVF_ANGULAR_WIDTH=64 FOV_GVF_ANGULAR_HEIGHT=48
export FOV_GVF_CHART_WIDTH=24 FOV_GVF_CHART_HEIGHT=18
export FOV_GVF_HISTORY_SAMPLE_INTERVAL=1 FOV_GVF_HISTORY_MAX_OBSERVATIONS=16
export FOV_GVF_DEPTH_UNCERTAINTY=1 FOV_GVF_DEPTH_SIGMA0=.005 FOV_GVF_DEPTH_SIGMA_RANGE2=0
export FOV_GVF_DYNAMIC_OBSTACLES=0 FOV_GVF_SHARED_OBSTACLES=0
export FOV_GVF_SPHERICAL_MEMORY=0 FOV_GVF_INCREMENTAL_FIELD=0 FOV_GVF_OPERATOR_ASSISTANCE=0
unset ISAAC_GOAL_PROTOCOL ISAAC_BENCHMARK_RESULT ISAAC_INTENT_TRACE ISAAC_EXPLORATION_STALL_S
unset ISAAC_DEPTH_HFOV_DEG ISAAC_DEPTH_CAMERA_OFFSET_M
unset FOV_GVF_ESDF_OCCUPANCY FOV_GVF_ACTUAL_SCENE
unset FOV_GVF_RUN_ID FOV_GVF_REPLAY_DIR FOV_GVF_RUNTIME_MANIFEST FOV_GVF_PERFORMANCE_LOG
unset EGO_PROFILE_ROOT

# Active ascent/descent and bounded unknown-space execution (trial limits).
export FOV_GVF_EXECUTION_CONSISTENT=1 FOV_GVF_ASSISTED_VERTICAL=1 FOV_GVF_BOUNDED_EXPLORATION=1
export FOV_GVF_TRACKING_MARGIN=.015 FOV_GVF_ASSIST_SPEED=.4 FOV_GVF_ASSIST_RADIUS=.8
export FOV_GVF_PROBE_SPEED=.3 FOV_GVF_PROBE_VERTICAL_SPEED=.2
export FOV_GVF_PROBE_DISTANCE_BUDGET=3.5 FOV_GVF_PROBE_TIME_BUDGET=12 FOV_GVF_PROBE_VOLUME_BUDGET=5
export FOV_GVF_PROBE_ANCHOR_RANGE=3 FOV_GVF_PROBE_CLEARANCE=.08

# Local 12-thread Ryzen: pin only when explicitly configured; retain validated delay.
export EGO5090_CONTROLLER_CPU_AFFINITY="${EGO2P6_CONTROLLER_CPU_AFFINITY:-}"
export FOV_GVF_PIPELINE_DELAY=.20
export FOV_GVF_FREE_SPACE_CEILING_ENABLED=1 FOV_GVF_FREE_SPACE_CEILING_Z=19.8
export FOV_GVF_GOAL_CACHE_DISPLACEMENT=.75

# Working region from finite voxel extent; full-body margins keep centers
# inside the ESDF interpolation domain.
export FOV_GVF_WORKING_BOUNDS_ENABLED=1
export FOV_GVF_WORKING_MIN_X=-80 FOV_GVF_WORKING_MAX_X=399.8
export FOV_GVF_WORKING_MIN_Y=-60 FOV_GVF_WORKING_MAX_Y=59.8
