# Shared step-1 base profile; motion output remains disabled.
EGO4_PROFILE_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
export ISAAC_MANUAL_INPUT_MODE="${ISAAC_MANUAL_INPUT_MODE:-joystick}"
export ISAAC_HEADLESS="${ISAAC_HEADLESS:-0}" ISAAC_MANUAL_TIMEOUT=0
export FOV_GVF_RVIZ="${FOV_GVF_RVIZ:-true}"
EGO4P2_PROFILE_EXPORTS="$(/usr/bin/python3 -B "$EGO4_PROFILE_ROOT/scripts/base_config.py" --check --shell)" || return 2
eval "$EGO4P2_PROFILE_EXPORTS"
unset EGO4P2_PROFILE_EXPORTS
export ISAAC_COMMAND_FRAME=world
export FOV_GVF_SCENE_MODE=cloud
export FOV_GVF_SCENE="${FOV_GVF_SCENE:-$EGO4_PROFILE_ROOT/scenes/ego_swarm_cloud/ego_swarm_cloud_navigation.usd}"
export FOV_GVF_INSTALL="$EGO4_PROFILE_ROOT/docs/performance/runtime/install"
# No old controller path, field/flow-box parameters or recovery budget is loaded.
unset EGO4_PROFILE_ROOT
